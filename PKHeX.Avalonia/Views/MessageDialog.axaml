<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKHeX.Avalonia.Views.MessageDialog"
        Title="PKHeX"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MinWidth="320" MaxWidth="720">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="B_Yes" Content="Yes" MinWidth="80" IsVisible="False" Click="B_Yes_Click" />
      <Button x:Name="B_No" Content="No" MinWidth="80" IsVisible="False" Click="B_No_Click" />
      <Button x:Name="B_OK" Content="OK" MinWidth="80" IsVisible="False" Click="B_OK_Click" />
      <Button x:Name="B_Cancel" Content="Cancel" MinWidth="80" IsVisible="False" Click="B_Cancel_Click" IsCancel="True" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock x:Name="L_Icon" FontSize="28" VerticalAlignment="Top" IsVisible="False" />
      <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="TB_Message" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" />
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</Window>
