<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Linux port: multi-target.
      * net10.0-windows: upstream System.Drawing.Common (GDI+) implementation, consumed by PKHeX.WinForms.
      * net10.0: cross-platform SkiaSharp implementation, consumed by PKHeX.Avalonia.
      Shared pixel logic lives in ImageUtil.cs; the bitmap-type specific members live in
      ImageUtil.Bitmap.cs (GDI+) and Skia/ImageUtil.Skia.cs (SkiaSharp).
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>PKHeX.Drawing</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.1" />
    <Compile Remove="Skia\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <Compile Remove="ImageUtil.Bitmap.cs" />
  </ItemGroup>

</Project>
